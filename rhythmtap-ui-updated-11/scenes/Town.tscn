theme_override_font_sizes/font_size = 40
text = "TOWN"

[node name="Receptionist" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
text = "Receptionist…"

[node name="Status" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Status"

[node name="Modifiers" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.7, 0.7, 1)
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
text = "Modifiers"

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="GuildButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
